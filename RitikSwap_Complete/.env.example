# Copy this file to .env and fill in your values
# NEVER commit your real .env to GitHub

# Get a free RPC URL from https://www.alchemy.com
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Export your MetaMask private key (use a TESTNET wallet only — never your real wallet)
PRIVATE_KEY=0xabc123...

# Get a free API key from https://etherscan.io/myapikey (used to verify contracts)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Set to "true" to see gas cost report after running tests
REPORT_GAS=false
